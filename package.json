{
  "name": "pmg-hub",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev db:studio email:dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "bun --filter @pmg/db db:generate",
    "db:migrate": "bun --filter @pmg/db db:migrate",
    "db:push": "bun --filter @pmg/db db:push",
    "db:reset": "bun --filter @pmg/db db:reset",
    "db:seed": "bun --filter @pmg/db db:seed",
    "db:studio": "bun --filter @pmg/db db:studio"
  },
  "catalog": {
    "astro": "^7.3.5",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "typescript": "5.9.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "turbo": "^2.11.4",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "pdf-lib": "^1.17.1",
    "zod": "catalog:"
  },
  "overrides": {
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@react-email/components": "^1.0.1",
    "resend": "^4.0.0",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "js-yaml": "^4.3.2",
    "postcss": "8.5.26",
    "path-to-regexp": "^6.3.0",
    "hono": "^4.12.34",
    "@hono/node-server": "^1.19.15",
    "dompurify": "^3.4.13",
    "esbuild": "0.28.1",
    "next": "16.3.6",
    "fast-uri": "^3.1.6",
    "browserslist": "^4.28.7",
    "smol-toml": "^1.8.0"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
