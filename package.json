{
  "name": "pmg-hub",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev db:studio email:dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "bun --filter @pmg/db db:generate",
    "db:migrate": "bun --filter @pmg/db db:migrate",
    "db:push": "bun --filter @pmg/db db:push",
    "db:reset": "bun --filter @pmg/db db:reset",
    "db:seed": "bun --filter @pmg/db db:seed",
    "db:studio": "bun --filter @pmg/db db:studio"
  },
  "catalog": {
    "astro": "^6.0.8",
    "tailwindcss": "4.2.2",
    "@tailwindcss/vite": "4.2.2",
    "@tailwindcss/node": "4.2.2",
    "@tailwindcss/oxide": "4.2.2",
    "typescript": "5.9.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "zod": "catalog:"
  },
  "overrides": {
    "tailwindcss": "4.2.2",
    "@tailwindcss/vite": "4.2.2",
    "@tailwindcss/node": "4.2.2",
    "@tailwindcss/oxide": "4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@react-email/components": "^1.0.1",
    "resend": "^4.0.0",
    "tar": "^7.5.8",
    "brace-expansion": "^1.1.17",
    "socket.io-parser": "^4.2.7",
    "vite": "^6.4.3",
    "undici": "^7.29.0",
    "svgo": "^4.0.2",
    "js-yaml": "^4.3.1",
    "ip-address": "^10.3.1",
    "nanoid": "^3.3.16",
    "postcss": "^8.5.26",
    "sharp": "^0.35.0",
    "fast-uri": "^3.1.5",
    "path-to-regexp": "^6.3.0",
    "next": "^16.2.12"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
