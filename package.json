{
  "name": "pmg-hub",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev db:studio email:dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "bun --filter @pmg/db db:generate",
    "db:migrate": "bun --filter @pmg/db db:migrate",
    "db:push": "bun --filter @pmg/db db:push",
    "db:reset": "bun --filter @pmg/db db:reset",
    "db:seed": "bun --filter @pmg/db db:seed",
    "db:studio": "bun --filter @pmg/db db:studio"
  },
  "catalog": {
    "astro": "^7.0.6",
    "tailwindcss": "4.2.2",
    "@tailwindcss/vite": "4.2.2",
    "@tailwindcss/node": "4.2.2",
    "@tailwindcss/oxide": "4.2.2",
    "typescript": "5.9.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.9.6",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "zod": "catalog:"
  },
  "overrides": {
    "tailwindcss": "4.2.2",
    "@tailwindcss/vite": "4.2.2",
    "@tailwindcss/node": "4.2.2",
    "@tailwindcss/oxide": "4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@react-email/components": "^1.0.1",
    "resend": "^4.0.0",
    "sharp": "^0.35.0",
    "postcss": "8.5.26",
    "path-to-regexp": "^6.3.0",
    "hono": "^4.12.34",
    "@hono/node-server": "^1.19.15",
    "dompurify": "^3.4.13",
    "esbuild": "^0.28.0",
    "next": "16.3.1"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide"
  ]
}
