---
import Layout from '../../../layouts/Layout.astro';
import UpsellBanner from '../../../components/UpsellBanner.astro';
import { getPublicDocumentCategoryByUrlSlug } from '@pmg/db';
import {
  getPublishedDocuments,
  getActiveCategoryList,
  formatFileMeta,
} from '../../../lib/public-documents';

const categoryParam = Astro.params.category || '';
const categoryMeta = getPublicDocumentCategoryByUrlSlug(categoryParam);

if (!categoryMeta) {
  return new Response(null, { status: 404, statusText: 'Category Not Found' });
}

const allDocuments = await getPublishedDocuments();
const activeCategories = getActiveCategoryList(allDocuments);
const documents = allDocuments.filter((d) => d.category === categoryMeta.key);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=600');

const SITE_URL = 'https://www.tenderedgesolutions.co.za';
const canonical = `${SITE_URL}/templates/category/${categoryMeta.urlSlug}`;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: categoryMeta.seoTitle,
  description: categoryMeta.seoDescription,
  url: canonical,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: documents.length,
    itemListElement: documents.map((doc, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      url: `${SITE_URL}/templates/${doc.slug}`,
      name: doc.code ? `${doc.code} — ${doc.title}` : doc.title,
    })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Tender Templates', item: `${SITE_URL}/templates` },
    { '@type': 'ListItem', position: 3, name: categoryMeta.label, item: canonical },
  ],
};
---

<Layout
  title={categoryMeta.seoTitle}
  description={categoryMeta.seoDescription}
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="relative min-h-[50vh] flex flex-col justify-center pt-28 pb-16 md:pt-36 md:pb-20 px-6 md:px-12 diagonal-lines border-b border-border">
    <div class="max-w-7xl mx-auto w-full">
      <nav aria-label="Breadcrumb" class="mb-6 text-xs uppercase tracking-widest text-muted-foreground">
        <ol class="flex items-center space-x-2">
          <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/templates" class="hover:text-primary transition-colors">Templates</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-semibold text-primary" aria-current="page">{categoryMeta.label}</li>
        </ol>
      </nav>

      <p class="text-primary uppercase tracking-widest font-medium text-[10px] md:text-[11px] mb-4">
        COMPLIANCE RESOURCES — {categoryMeta.label.toUpperCase()}
      </p>
      <h1 class="font-condensed uppercase text-5xl md:text-7xl lg:text-8xl leading-[0.9] mb-6">
        {categoryMeta.heroTitle}<br />
        <span class="text-primary">{categoryMeta.heroAccent}</span>
      </h1>
      <p class="text-muted-foreground text-lg md:text-xl max-w-3xl">
        {categoryMeta.intro}
      </p>

      <!-- Category Filter Pills -->
      <div class="mt-10 flex flex-wrap gap-2.5">
        <a
          href="/templates"
          class="inline-flex items-center gap-2 rounded-full bg-card border border-border text-muted-foreground hover:text-foreground hover:border-primary/50 px-4 py-2 text-xs font-semibold uppercase tracking-wider transition-colors"
        >
          All Templates
          <span class="text-[11px] opacity-70">({allDocuments.length})</span>
        </a>
        {
          activeCategories.map((cat) => {
            const isActive = cat.key === categoryMeta.key;
            return (
              <a
                href={`/templates/category/${cat.urlSlug}`}
                class={
                  isActive
                    ? 'inline-flex items-center gap-2 rounded-full bg-primary text-primary-foreground px-4 py-2 text-xs font-bold uppercase tracking-wider shadow-sm'
                    : 'inline-flex items-center gap-2 rounded-full bg-card border border-border text-muted-foreground hover:text-foreground hover:border-primary/50 px-4 py-2 text-xs font-semibold uppercase tracking-wider transition-colors'
                }
              >
                {cat.label}
                <span class="text-[11px] opacity-80">({cat.count})</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 px-6 md:px-12">
    <div class="max-w-7xl mx-auto w-full">
      {
        documents.length === 0 ? (
          <div class="rounded-xl border border-dashed border-border p-12 text-center">
            <p class="text-lg font-medium text-foreground">
              No {categoryMeta.label.toLowerCase()} published yet.
            </p>
            <p class="mt-2 text-sm text-muted-foreground mb-6">
              Browse all available tender templates or contact our team on WhatsApp for assistance.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-3">
              <a
                href="/templates"
                class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 py-3 text-xs font-bold uppercase tracking-wider hover:bg-primary-hover transition-colors"
              >
                Browse All Templates
              </a>
              <a
                href={`https://wa.me/27745017094?text=${encodeURIComponent(`Hi, I'm looking for ${categoryMeta.label} templates for my tender submission.`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-md border border-border bg-card text-foreground px-6 py-3 text-xs font-bold uppercase tracking-wider hover:border-primary/60 transition-colors"
              >
                Request via WhatsApp
              </a>
            </div>
          </div>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {documents.map((doc) => {
              const fileMeta = formatFileMeta(doc.mimeType, doc.fileSize, doc.fileName || doc.s3Key);
              return (
                <a
                  href={`/templates/${doc.slug}`}
                  class="group flex flex-col bg-card border border-border rounded-xl p-6 transition-all hover:-translate-y-1 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5"
                >
                  <div class="flex items-center justify-between gap-2 mb-4">
                    <span class="inline-flex items-center rounded-md bg-primary/10 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-primary">
                      {categoryMeta.label}
                    </span>
                    <span class="inline-flex items-center rounded border border-border bg-background/60 px-2 py-0.5 text-[10px] font-mono font-semibold text-muted-foreground">
                      {fileMeta.shortLabel}
                      {fileMeta.sizeLabel ? ` • ${fileMeta.sizeLabel}` : ''}
                    </span>
                  </div>

                  {doc.code && (
                    <p class="text-primary font-condensed text-3xl font-bold leading-none mb-1">
                      {doc.code}
                    </p>
                  )}
                  <h2 class="text-foreground text-lg font-bold tracking-tight group-hover:text-primary transition-colors">
                    {doc.title}
                  </h2>
                  {doc.subtitle && (
                    <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground mt-1 mb-3">
                      {doc.subtitle}
                    </p>
                  )}
                  <p class="text-muted-foreground text-sm flex-1 line-clamp-3 mt-1">
                    {doc.seoDescription || doc.subtitle}
                  </p>
                  <div class="mt-6 pt-4 border-t border-border/50 flex items-center justify-between text-primary text-xs font-semibold uppercase tracking-wider">
                    <span class="inline-flex items-center gap-2 group-hover:translate-x-1 transition-transform">
                      View &amp; Download
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                      </svg>
                    </span>
                    <span class="text-[11px] font-normal text-muted-foreground normal-case">
                      Free {fileMeta.shortLabel}
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        )
      }
    </div>
  </section>

  <UpsellBanner
    heading={`NEED HELP WITH ${categoryMeta.label.toUpperCase()}?`}
    description={`Our compliance specialists prepare ${categoryMeta.label.toLowerCase()}, verify your CSD & B-BBEE returnables, and package your full tender submission — including optional hand-delivery with video proof.`}
    whatsappText={`Hi, I need help with ${categoryMeta.label} for my tender submission.`}
  />
</Layout>
