---
import Layout from '@/layouts/Layout.astro';
import { actions } from 'astro:actions';
import { getDb, leads, bridgeDatabaseEnv, eq } from '@pmg/db';

const result = Astro.getActionResult(actions.submitOnboarding);
const inputErrors = result?.error && 'fields' in result.error ? (result.error.fields as Record<string, string[]>) : {};
const isSuccess = result?.data?.success === true;

const leadId = Astro.url.searchParams.get('lead') || '';

let prefilled = {
	contactName: '',
	companyName: '',
	email: '',
	phone: '',
};

if (leadId) {
	try {
		const env = import.meta.env as Record<string, string | undefined>;
		bridgeDatabaseEnv(env);
		const db = getDb();
		const leadData = await db.query.leads.findFirst({
			where: eq(leads.id, leadId),
		});

		if (leadData) {
			prefilled = {
				contactName: leadData.name || '',
				companyName: leadData.companyName || '',
				email: leadData.email || '',
				phone: leadData.phone || '',
			};
		}
	} catch (e) {
		console.error('[TES onboard page] Failed to pre-fetch lead:', e);
	}
}

const BRAND = {
	name: 'Tender Edge Solutions',
	whatsapp: '27745017094',
	portalUrl: 'https://portal.tenderedgesolutions.co.za',
};
---

<Layout
	title="Client Compliance Setup | Tender Edge Solutions"
	description="Complete your client profile to activate your tender compliance, CSD, and CIDB filings."
	robots="noindex, nofollow"
>
	<main class="relative min-h-[calc(100vh-140px)] pt-28 md:pt-36 pb-20 px-4 sm:px-6 flex items-center justify-center overflow-hidden">
		<!-- Subtle ambient glow matching TES gold accents -->
		<div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-[500px] h-[350px] bg-primary/10 rounded-full blur-3xl -z-10" aria-hidden="true"></div>

		<div class="w-full max-w-lg bg-card/90 border border-border/80 rounded-2xl p-6 sm:p-10 shadow-2xl backdrop-blur-md relative z-10">
			<!-- Header inside card -->
			<div class="text-center mb-8">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/25 text-primary text-xs font-semibold uppercase tracking-wider mb-3">
					<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
					<span>Client Onboarding</span>
				</div>
				<h1 class="font-condensed text-3xl sm:text-4xl text-foreground font-bold tracking-tight">
					Client Profile Setup
				</h1>
				<p class="text-muted-foreground text-sm mt-2 font-normal">
					Please confirm your details below to activate your account profile.
				</p>
			</div>

			{isSuccess ? (
				<div class="py-6 text-center">
					<div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="20 6 9 17 4 12"/>
						</svg>
					</div>
					<h2 class="font-condensed text-2xl sm:text-3xl text-foreground font-bold mb-2">Compliance Profile Received!</h2>
					<p class="text-muted-foreground text-sm leading-relaxed mb-8 max-w-sm mx-auto">
						Thank you for submitting your details. Our tender specialists have received your file and will follow up with you shortly.
					</p>

					<div class="flex flex-col gap-3">
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
							<a
								href={`https://wa.me/${BRAND.whatsapp}?text=${encodeURIComponent('Hi Tender Edge Solutions, I have submitted our onboarding profile.')}`}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#20bd5a] text-white px-5 py-3.5 rounded-xl text-xs sm:text-sm font-bold shadow-md transition-all duration-200 hover:-translate-y-0.5 active:scale-[0.98]"
							>
								<svg viewBox="0 0 24 24" class="w-4 h-4 shrink-0 fill-current">
									<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
								</svg>
								<span>Notify on WhatsApp</span>
							</a>
							<a
								href={BRAND.portalUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center justify-center gap-2 bg-card hover:bg-muted/80 text-foreground border border-border px-5 py-3.5 rounded-xl text-xs sm:text-sm font-bold shadow-sm transition-all duration-200 hover:-translate-y-0.5"
							>
								<svg viewBox="0 0 24 24" class="w-4 h-4 shrink-0 stroke-current text-primary" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
									<polyline points="10 17 15 12 10 7"></polyline>
									<line x1="15" y1="12" x2="3" y2="12"></line>
								</svg>
								<span>Go to Client Portal</span>
							</a>
						</div>
						<a href="/" class="text-xs text-muted-foreground hover:text-foreground transition-colors pt-2">
							Return to Homepage
						</a>
					</div>
				</div>
			) : (
				<form method="POST" action={actions.submitOnboarding} class="space-y-4" novalidate id="tes-onboard-form">
					<!-- Honeypot -->
					<div style="position: absolute; left: -9999px;" aria-hidden="true">
						<input type="text" name="_website" tabindex="-1" autocomplete="off" />
					</div>
					<input type="hidden" name="_loadedAt" id="tes-onboard-loaded-at" value="" />
					<input type="hidden" name="leadId" value={leadId} />

					<!-- Cloudflare Turnstile -->
					{import.meta.env.TURNSTILE_SITE_KEY && (
						<div class="flex justify-center my-2">
							<div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY} data-action="_turnstile" data-theme="dark"></div>
						</div>
					)}

					{result?.error && !('fields' in result.error) && (
						<div class="p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-xs flex items-center gap-2.5">
							<svg class="w-4 h-4 shrink-0 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="10"></circle>
								<line x1="12" y1="8" x2="12" y2="12"></line>
								<line x1="12" y1="16" x2="12.01" y2="16"></line>
							</svg>
							<span>Something went wrong submitting your profile. Please message us on WhatsApp.</span>
						</div>
					)}

					<!-- Field: Contact Name -->
					<div class="space-y-1.5 text-left">
						<label for="contactName" class="text-xs font-semibold text-foreground/90 uppercase tracking-wider flex items-center gap-1">
							<span>Your Full Name</span>
							<span class="text-primary">*</span>
						</label>
						<input
							type="text"
							id="contactName"
							name="contactName"
							required
							autocomplete="name"
							placeholder="e.g. Jacob Dlamini"
							value={prefilled.contactName}
							class="w-full bg-background border border-border focus:border-primary focus:ring-1 focus:ring-primary rounded-xl px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/40 outline-none transition-all"
						/>
						{inputErrors.contactName?.[0] && (
							<p class="text-red-400 text-xs">{inputErrors.contactName[0]}</p>
						)}
					</div>

					<!-- Field: Company Name -->
					<div class="space-y-1.5 text-left">
						<label for="companyName" class="text-xs font-semibold text-foreground/90 uppercase tracking-wider flex items-center gap-1">
							<span>Registered Business Name</span>
							<span class="text-primary">*</span>
						</label>
						<input
							type="text"
							id="companyName"
							name="companyName"
							required
							autocomplete="organization"
							placeholder="e.g. Dlamini Construction (Pty) Ltd"
							value={prefilled.companyName}
							class="w-full bg-background border border-border focus:border-primary focus:ring-1 focus:ring-primary rounded-xl px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/40 outline-none transition-all"
						/>
						{inputErrors.companyName?.[0] && (
							<p class="text-red-400 text-xs">{inputErrors.companyName[0]}</p>
						)}
					</div>

					<!-- Field: Email Address -->
					<div class="space-y-1.5 text-left">
						<label for="email" class="text-xs font-semibold text-foreground/90 uppercase tracking-wider flex items-center gap-1">
							<span>Email Address</span>
							<span class="text-primary">*</span>
						</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							autocomplete="email"
							placeholder="e.g. info@dlaminiconstruction.co.za"
							value={prefilled.email}
							class="w-full bg-background border border-border focus:border-primary focus:ring-1 focus:ring-primary rounded-xl px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/40 outline-none transition-all"
						/>
						{inputErrors.email?.[0] && (
							<p class="text-red-400 text-xs">{inputErrors.email[0]}</p>
						)}
					</div>

					<!-- Field: Phone / WhatsApp -->
					<div class="space-y-1.5 text-left">
						<label for="phone" class="text-xs font-semibold text-foreground/90 uppercase tracking-wider flex items-center gap-1">
							<span>Phone / WhatsApp Number</span>
							<span class="text-primary">*</span>
						</label>
						<input
							type="tel"
							id="phone"
							name="phone"
							required
							autocomplete="tel"
							placeholder="e.g. 082 123 4567"
							value={prefilled.phone}
							class="w-full bg-background border border-border focus:border-primary focus:ring-1 focus:ring-primary rounded-xl px-4 py-3 text-sm text-foreground placeholder:text-muted-foreground/40 outline-none transition-all"
						/>
						{inputErrors.phone?.[0] && (
							<p class="text-red-400 text-xs">{inputErrors.phone[0]}</p>
						)}
					</div>

					<!-- Field: CIPC Registration Number (Optional) -->
					<div class="space-y-1.5 text-left">
						<div class="flex items-center justify-between">
							<label for="registrationNumber" class="text-xs font-semibold text-foreground/90 uppercase tracking-wider">
								<span>CIPC Registration No.</span>
							</label>
							<span class="text-[10px] uppercase tracking-wider text-muted-foreground/60">Optional</span>
						</div>
						<input
							type="text"
							id="registrationNumber"
							name="registrationNumber"
							placeholder="e.g. 2024/123456/07"
							class="w-full bg-background border border-border focus:border-primary focus:ring-1 focus:ring-primary rounded-xl px-4 py-3 text-sm text-foreground font-mono placeholder:text-muted-foreground/40 outline-none transition-all"
						/>
					</div>

					<!-- Submit Button -->
					<div class="pt-2">
						<button
							type="submit"
							id="tes-onboard-submit-btn"
							class="w-full bg-primary hover:bg-primary/90 text-primary-foreground font-bold text-sm tracking-wide py-3.5 px-6 rounded-xl shadow-lg shadow-primary/20 transition-all duration-200 hover:-translate-y-0.5 active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer"
						>
							<span>Establish Compliance Profile</span>
							<svg class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</button>
					</div>
				</form>
			)}

			<div class="mt-6 flex items-center justify-center gap-1.5 text-xs text-muted-foreground/70 text-center">
				<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
					<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
				</svg>
				<span>Secure compliance verification & storage</span>
			</div>
		</div>
	</main>

	<script>
		const loadedAtInput = document.getElementById('tes-onboard-loaded-at') as HTMLInputElement | null;
		if (loadedAtInput) {
			loadedAtInput.value = Date.now().toString();
		}

		const form = document.getElementById('tes-onboard-form') as HTMLFormElement | null;
		const submitBtn = document.getElementById('tes-onboard-submit-btn') as HTMLButtonElement | null;
		if (form && submitBtn) {
			form.addEventListener('submit', () => {
				submitBtn.disabled = true;
				submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
				submitBtn.innerHTML = `
					<svg class="w-4 h-4 animate-spin shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
						<circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"></circle>
					</svg>
					<span>Submitting Profile...</span>
				`;
			});
		}
	</script>
</Layout>
