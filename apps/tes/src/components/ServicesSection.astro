---
import { services, addOnServices } from '../data/services';

const icons = [
  // Full Tender Preparation - folder
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c9a227" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>`,
  // RFQ & RFI Preparation - file with question mark
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c9a227" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 22h14a2 2 0 0 0 2-2V7.5L14.5 2H6a2 2 0 0 0-2 2v5"/><path d="M14 2v6h6"/><path d="M10 13a2 2 0 1 1 3 1.732c-.6.35-1 1.02-1 1.768"/><line x1="12" y1="19.5" x2="12" y2="19.51"/></svg>`,
  // Supplier & Vendor Database Registration - database
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c9a227" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg>`,
];
---

<section id='services' class='bg-card py-20 md:py-28 px-6 md:px-12 dot-grid'>
  <div class='max-w-7xl mx-auto'>
    <p class='reveal text-primary uppercase tracking-widest text-[10px] md:text-[11px] font-medium'>
      WHAT WE DO
    </p>
    <h2 class='reveal font-condensed text-4xl md:text-5xl text-foreground mt-4 mb-12' data-delay="80">
      Everything you need to submit with confidence.
    </h2>

    <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
      {services.map((service, i) => (
        <div class='reveal service-card bg-background border border-[--border] rounded-xl p-5 flex flex-col gap-3 relative overflow-hidden' data-delay={String(i * 80)}>
          <!-- Gold left accent bar -->
          <span class='accent-bar' aria-hidden='true'></span>

          <!-- Icon + title row -->
          <div class='flex items-start gap-3'>
            <div class='icon-wrap shrink-0 w-9 h-9 rounded-lg flex items-center justify-center' style='background: rgba(201,162,39,0.12);'>
              <Fragment set:html={icons[i]} />
            </div>
            <p class='text-foreground font-semibold text-base pt-1'>{service.name}</p>
          </div>

          <p class='text-muted-foreground text-sm leading-relaxed'>{service.description}</p>
        </div>
      ))}
    </div>

    <!-- Add-on services -->
    <div class='reveal mt-4 bg-primary/10 border border-primary/30 rounded-xl p-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-4' data-delay="240">
      <div>
        <p class='text-foreground font-semibold'>Also available</p>
        <div class='flex flex-wrap gap-2 mt-2'>
          {addOnServices.map((addOn) => (
            <span class='text-xs text-muted-foreground bg-background border border-[--border] rounded-full px-3 py-1'>
              {addOn.name}
            </span>
          ))}
        </div>
      </div>
      <a
        href='#contact'
        class='text-primary hover:text-primary-hover font-medium text-sm transition-colors whitespace-nowrap flex items-center gap-1.5'
      >
        Ask us about these
        <svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><line x1='5' y1='12' x2='19' y2='12'/><polyline points='12 5 19 12 12 19'/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .service-card {
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .service-card:hover {
    border-color: rgba(201, 162, 39, 0.4);
    background-color: rgba(201, 162, 39, 0.03);
  }
  .accent-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--primary);
    border-radius: 3px 0 0 3px;
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.25s ease;
  }
  .service-card:hover .accent-bar {
    transform: scaleY(1);
  }
</style>