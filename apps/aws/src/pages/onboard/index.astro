---
import Layout from "@/layouts/Layout.astro";
import { actions } from "astro:actions";
import { getDb, leads, bridgeDatabaseEnv, eq } from "@pmg/db";

const result = Astro.getActionResult(actions.submitOnboarding);
const inputErrors =
  result?.error && "fields" in result.error
    ? (result.error.fields as Record<string, string[]>)
    : {};
const isSuccess = result?.data?.success === true;

const leadId = Astro.url.searchParams.get("lead") || "";

let prefilled = {
  contactName: "",
  companyName: "",
  email: "",
  phone: "",
};

if (leadId) {
  try {
    const env = import.meta.env as Record<string, string | undefined>;
    bridgeDatabaseEnv(env);
    const db = getDb();
    const leadData = await db.query.leads.findFirst({
      where: eq(leads.id, leadId),
    });

    if (leadData) {
      prefilled = {
        contactName: leadData.name || "",
        companyName: leadData.companyName || "",
        email: leadData.email || "",
        phone: leadData.phone || "",
      };
    }
  } catch (e) {
    console.error("[AWS onboard page] Failed to pre-fetch lead:", e);
  }
}

const BRAND = {
  name: "Apex Web Solutions",
  whatsapp: "27740491433",
  portalUrl: "https://portal.playhousemedia.co.za",
};
---

<Layout
  title="Client Account Setup | Apex Web Solutions"
  description="Complete your client profile to begin your web design and development services with Apex Web Solutions."
  robots="noindex, nofollow"
>
  <main
    class="relative flex min-h-[calc(100vh-140px)] items-center justify-center overflow-hidden px-4 pt-28 pb-20 sm:px-6 md:pt-36"
  >
    <!-- Subtle ambient glow matching AWS sky blue primary -->
    <div
      class="bg-primary/10 pointer-events-none absolute -top-24 left-1/2 -z-10 h-[350px] w-[500px] -translate-x-1/2 rounded-full blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div
      class="bg-card text-card-foreground border-border relative z-10 w-full max-w-lg rounded-2xl border p-6 shadow-xl sm:p-10"
    >
      <!-- Header inside card -->
      <div class="mb-8 text-center">
        <div
          class="bg-primary/10 border-primary/20 text-primary mb-3 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold tracking-wider uppercase"
        >
          <span class="bg-primary h-2 w-2 animate-pulse rounded-full"></span>
          <span>Client Onboarding</span>
        </div>
        <h1
          class="text-foreground text-2xl font-bold tracking-tight sm:text-3xl"
        >
          Client Profile Setup
        </h1>
        <p class="text-muted-foreground mt-2 text-sm font-normal">
          Please confirm your details below to activate your account profile.
        </p>
      </div>

      {
        isSuccess ? (
          <div class="py-6 text-center">
            <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-full border border-emerald-500/30 bg-emerald-500/15 text-emerald-400">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="20 6 9 17 4 12" />
              </svg>
            </div>
            <h2 class="text-foreground mb-2 text-2xl font-bold sm:text-3xl">
              Account Profile Received!
            </h2>
            <p class="text-muted-foreground mx-auto mb-8 max-w-sm text-sm leading-relaxed">
              Thank you for submitting your details. Our design & engineering
              team will reach out to you promptly to kick off your project.
            </p>

            <div class="flex flex-col gap-3">
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <a
                  href={`https://wa.me/${BRAND.whatsapp}?text=${encodeURIComponent("Hi Apex Web Solutions, I have submitted our onboarding profile.")}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#25D366] px-5 py-3.5 text-xs font-bold text-white shadow-md transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#20bd5a] active:scale-[0.98] sm:text-sm"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="h-4 w-4 shrink-0 fill-current"
                  >
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                  </svg>
                  <span>Notify on WhatsApp</span>
                </a>
                <a
                  href={BRAND.portalUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-background hover:bg-muted text-foreground border-border inline-flex items-center justify-center gap-2 rounded-xl border px-5 py-3.5 text-xs font-bold shadow-sm transition-all duration-200 hover:-translate-y-0.5 sm:text-sm"
                >
                  <svg
                    viewBox="0 0 24 24"
                    class="text-primary h-4 w-4 shrink-0 stroke-current"
                    fill="none"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                    <polyline points="10 17 15 12 10 7" />
                    <line x1="15" y1="12" x2="3" y2="12" />
                  </svg>
                  <span>Go to Client Portal</span>
                </a>
              </div>
              <a
                href="/"
                class="text-muted-foreground hover:text-foreground pt-2 text-xs transition-colors"
              >
                Return to Homepage
              </a>
            </div>
          </div>
        ) : (
          <form
            method="POST"
            action={actions.submitOnboarding}
            class="space-y-4"
            novalidate
            id="aws-onboard-form"
          >
            {/* Honeypot */}
            <div style="position: absolute; left: -9999px;" aria-hidden="true">
              <input
                type="text"
                name="_company_url"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <input
              type="hidden"
              name="_loadedAt"
              id="aws-onboard-loaded-at"
              value=""
            />
            <input type="hidden" name="leadId" value={leadId} />

            {/* Cloudflare Turnstile */}
            {import.meta.env.TURNSTILE_SITE_KEY && (
              <div class="my-2 flex justify-center">
                <div
                  class="cf-turnstile"
                  data-sitekey={import.meta.env.TURNSTILE_SITE_KEY}
                  data-action="_turnstile"
                  data-theme="dark"
                />
              </div>
            )}

            {result?.error && !("fields" in result.error) && (
              <div class="flex items-center gap-2.5 rounded-xl border border-red-500/30 bg-red-500/10 p-3.5 text-xs text-red-300">
                <svg
                  class="h-4 w-4 shrink-0 text-red-400"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="12" cy="12" r="10" />
                  <line x1="12" y1="8" x2="12" y2="12" />
                  <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                <span>
                  Something went wrong submitting your profile. Please message
                  us on WhatsApp.
                </span>
              </div>
            )}

            <div class="space-y-1.5 text-left">
              <label
                for="contactName"
                class="text-foreground/90 flex items-center gap-1 text-xs font-semibold tracking-wider uppercase"
              >
                <span>Your Full Name</span>
                <span class="text-primary">*</span>
              </label>
              <input
                type="text"
                id="contactName"
                name="contactName"
                required
                autocomplete="name"
                placeholder="e.g. Jacob Dlamini"
                value={prefilled.contactName}
                class="bg-background border-border focus:border-primary focus:ring-primary text-foreground placeholder:text-muted-foreground/40 w-full rounded-xl border px-4 py-3 text-sm transition-all outline-none focus:ring-1"
              />
              {inputErrors.contactName?.[0] && (
                <p class="text-xs text-red-400">{inputErrors.contactName[0]}</p>
              )}
            </div>

            <div class="space-y-1.5 text-left">
              <label
                for="companyName"
                class="text-foreground/90 flex items-center gap-1 text-xs font-semibold tracking-wider uppercase"
              >
                <span>Business / Brand Name</span>
                <span class="text-primary">*</span>
              </label>
              <input
                type="text"
                id="companyName"
                name="companyName"
                required
                autocomplete="organization"
                placeholder="e.g. Apex Enterprises (Pty) Ltd"
                value={prefilled.companyName}
                class="bg-background border-border focus:border-primary focus:ring-primary text-foreground placeholder:text-muted-foreground/40 w-full rounded-xl border px-4 py-3 text-sm transition-all outline-none focus:ring-1"
              />
              {inputErrors.companyName?.[0] && (
                <p class="text-xs text-red-400">{inputErrors.companyName[0]}</p>
              )}
            </div>

            <div class="space-y-1.5 text-left">
              <label
                for="email"
                class="text-foreground/90 flex items-center gap-1 text-xs font-semibold tracking-wider uppercase"
              >
                <span>Email Address</span>
                <span class="text-primary">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="e.g. jacob@example.co.za"
                value={prefilled.email}
                class="bg-background border-border focus:border-primary focus:ring-primary text-foreground placeholder:text-muted-foreground/40 w-full rounded-xl border px-4 py-3 text-sm transition-all outline-none focus:ring-1"
              />
              {inputErrors.email?.[0] && (
                <p class="text-xs text-red-400">{inputErrors.email[0]}</p>
              )}
            </div>

            <div class="space-y-1.5 text-left">
              <label
                for="phone"
                class="text-foreground/90 flex items-center gap-1 text-xs font-semibold tracking-wider uppercase"
              >
                <span>Phone / WhatsApp Number</span>
                <span class="text-primary">*</span>
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                autocomplete="tel"
                placeholder="e.g. 082 123 4567"
                value={prefilled.phone}
                class="bg-background border-border focus:border-primary focus:ring-primary text-foreground placeholder:text-muted-foreground/40 w-full rounded-xl border px-4 py-3 text-sm transition-all outline-none focus:ring-1"
              />
              {inputErrors.phone?.[0] && (
                <p class="text-xs text-red-400">{inputErrors.phone[0]}</p>
              )}
            </div>

            <div class="space-y-1.5 text-left">
              <div class="flex items-center justify-between">
                <label
                  for="registrationNumber"
                  class="text-foreground/90 text-xs font-semibold tracking-wider uppercase"
                >
                  <span>CIPC Registration No.</span>
                </label>
                <span class="text-muted-foreground/60 text-[10px] tracking-wider uppercase">
                  Optional
                </span>
              </div>
              <input
                type="text"
                id="registrationNumber"
                name="registrationNumber"
                placeholder="e.g. 2024/123456/07"
                class="bg-background border-border focus:border-primary focus:ring-primary text-foreground placeholder:text-muted-foreground/40 w-full rounded-xl border px-4 py-3 font-mono text-sm transition-all outline-none focus:ring-1"
              />
            </div>

            <div class="pt-2">
              <button
                type="submit"
                id="aws-onboard-submit-btn"
                class="bg-primary hover:bg-primary/90 text-primary-foreground shadow-primary/20 flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl px-6 py-3.5 text-sm font-bold tracking-wide shadow-lg transition-all duration-200 hover:-translate-y-0.5 active:scale-[0.98]"
              >
                <span>Establish Digital Profile</span>
                <svg
                  class="h-4 w-4 shrink-0 transition-transform group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </button>
            </div>
          </form>
        )
      }

      <div
        class="text-muted-foreground/70 mt-6 flex items-center justify-center gap-1.5 text-center text-xs"
      >
        <svg
          class="h-3.5 w-3.5 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>Protected by Apex Web Solutions digital infrastructure</span>
      </div>
    </div>
  </main>

  <script>
    const loadedAtInput = document.getElementById(
      "aws-onboard-loaded-at",
    ) as HTMLInputElement | null;
    if (loadedAtInput) {
      loadedAtInput.value = Date.now().toString();
    }

    const form = document.getElementById(
      "aws-onboard-form",
    ) as HTMLFormElement | null;
    const submitBtn = document.getElementById(
      "aws-onboard-submit-btn",
    ) as HTMLButtonElement | null;
    if (form && submitBtn) {
      form.addEventListener("submit", () => {
        submitBtn.disabled = true;
        submitBtn.classList.add("opacity-75", "cursor-not-allowed");
        submitBtn.innerHTML = `
					<svg class="w-4 h-4 animate-spin shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
						<circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="12"></circle>
					</svg>
					<span>Submitting Profile...</span>
				`;
      });
    }
  </script>
</Layout>
