---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const SITE_URL = 'https://playhousemedia.co.za';
const currentURL = `${SITE_URL}/blog/${post.id}`;
const canonicalURL = post.data.canonicalUrl || currentURL;

const formattedDate = post.data.publishedAt.toLocaleDateString('en-ZA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// JSON-LD BlogPosting Schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${currentURL}#article`,
  headline: post.data.title,
  description: post.data.description,
  image: post.data.coverImage ? new URL(post.data.coverImage, SITE_URL).href : undefined,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: post.data.publishedAt.toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': currentURL,
  },
  author: {
    '@type': 'Person',
    name: post.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Playhouse Media Group',
    url: SITE_URL,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/favicon.svg`,
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE_URL,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'News & Insights',
      item: `${SITE_URL}/blog`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: currentURL,
    },
  ],
};
---

<Layout
  title={`${post.data.title} | Playhouse Media Group`}
  description={post.data.description}
  canonical={canonicalURL}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="noise" aria-hidden="true"></div>
  <div class="page-container min-h-screen flex flex-col justify-between">
    <div>
      <Header />

      <article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pt-28 sm:pt-32 pb-24">
        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-400">
          <ol class="flex items-center space-x-2">
            <li>
              <a href="/" class="hover:text-white transition-colors">Home</a>
            </li>
            <li aria-hidden="true">/</li>
            <li>
              <a href="/blog" class="hover:text-white transition-colors">News & Insights</a>
            </li>
            <li aria-hidden="true">/</li>
            <li
              class="font-medium text-white truncate max-w-[200px] sm:max-w-xs"
              aria-current="page"
            >
              {post.data.title}
            </li>
          </ol>
        </nav>

        <!-- Header -->
        <header class="border-b border-slate-800 pb-8">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            {
              post.data.tags.map((tag) => (
                <span class="inline-flex items-center rounded-md bg-amber-400/10 px-2.5 py-0.5 text-xs font-semibold text-amber-300">
                  {tag}
                </span>
              ))
            }
            {
              post.data.draft && (
                <span class="inline-flex items-center rounded-md bg-rose-500/10 px-2.5 py-0.5 text-xs font-semibold text-rose-400">
                  Draft
                </span>
              )
            }
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-white leading-tight">
            {post.data.title}
          </h1>

          <p class="mt-4 text-lg text-slate-300 leading-relaxed">
            {post.data.description}
          </p>

          <div class="mt-6 flex items-center justify-between text-sm text-slate-400">
            <div class="flex items-center gap-2">
              <span>By</span>
              <span class="font-semibold text-slate-200">{post.data.author}</span>
            </div>
            <time datetime={post.data.publishedAt.toISOString()}>
              {formattedDate}
            </time>
          </div>
        </header>

        <!-- Cover Image -->
        {
          post.data.coverImage && (
            <div class="aspect-16/9 my-8 overflow-hidden rounded-2xl bg-slate-800 shadow-lg">
              <img
                src={post.data.coverImage}
                alt={post.data.title}
                class="h-full w-full object-cover"
              />
            </div>
          )
        }

        <!-- Post Content -->
        <div
          class="prose prose-invert max-w-none mt-8 leading-relaxed space-y-6 text-slate-200 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:text-white [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-white [&_p]:text-slate-300 [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:space-y-2 [&_li]:text-slate-300 [&_strong]:text-white [&_a]:text-amber-400 [&_a]:underline [&_a]:underline-offset-4 hover:[&_a]:text-amber-300 [&_hr]:my-8 [&_hr]:border-slate-800"
        >
          <Content />
        </div>

        <!-- Back link footer -->
        <footer class="mt-16 border-t border-slate-800 pt-8 flex items-center justify-between">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-sm font-semibold text-amber-400 hover:text-amber-300 transition-colors focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:outline-none rounded-md"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m12 19-7-7 7-7"></path>
              <path d="M19 12H5"></path>
            </svg>
            Back to all articles
          </a>

          <a
            href="/"
            class="inline-flex items-center text-sm text-slate-400 hover:text-white transition-colors"
          >
            PMG Corporate Home
          </a>
        </footer>
      </article>
    </div>

    <Footer />
  </div>
</Layout>
