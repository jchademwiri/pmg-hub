---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export const prerender = true;

// Fetch published posts
const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Sort newest first
const posts = allPosts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const pageTitle = 'Corporate News & Insights | Playhouse Media Group';
const pageDescription =
  'News, announcements, and perspectives on South African SME transformation, public procurement, and web technology from Playhouse Media Group.';

const SITE_URL = 'https://playhousemedia.co.za';
const canonicalURL = `${SITE_URL}/blog`;

// JSON-LD Breadcrumbs
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: SITE_URL,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: canonicalURL,
    },
  ],
};

// JSON-LD Blog Collection
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${canonicalURL}#blog`,
  name: 'Playhouse Media Group Blog',
  description: pageDescription,
  url: canonicalURL,
  publisher: {
    '@type': 'Organization',
    name: 'Playhouse Media Group',
    url: SITE_URL,
    logo: `${SITE_URL}/favicon.svg`,
  },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishedAt.toISOString(),
    url: `${SITE_URL}/blog/${post.id}`,
    author: {
      '@type': 'Person',
      name: post.data.author,
    },
  })),
};
---

<Layout title={pageTitle} description={pageDescription} canonical={canonicalURL}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <div class="noise" aria-hidden="true"></div>
  <div class="page-container min-h-screen flex flex-col justify-between">
    <div>
      <Header />

      <!-- Main Content -->
      <main class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pt-28 sm:pt-32 pb-24">
        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-400">
          <ol class="flex items-center space-x-2">
            <li>
              <a href="/" class="hover:text-white transition-colors">Home</a>
            </li>
            <li aria-hidden="true">/</li>
            <li class="font-medium text-white" aria-current="page">News & Insights</li>
          </ol>
        </nav>

        <!-- Header -->
        <div class="mb-14 max-w-2xl">
          <h1 class="mb-4 text-3xl font-extrabold tracking-tight sm:text-5xl text-white">
            Corporate News & <span class="text-amber-400">Insights</span>
          </h1>
          <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
            Strategic updates, holding announcements, and industry perspectives from the Playhouse
            Media Group portfolio.
          </p>
        </div>

        <!-- Posts Grid -->
        {
          posts.length === 0 ? (
            <div class="rounded-2xl border border-dashed border-slate-700/80 p-12 text-center bg-slate-900/40">
              <p class="text-lg font-medium text-white">No articles published yet.</p>
              <p class="mt-1 text-sm text-slate-400">
                Check back soon for corporate news and announcements.
              </p>
            </div>
          ) : (
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
              {posts.map((post) => {
                const formattedDate = post.data.publishedAt.toLocaleDateString('en-ZA', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                });

                return (
                  <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 p-6 transition-all duration-300 hover:border-amber-500/50 hover:shadow-xl hover:shadow-amber-500/5 backdrop-blur-xs">
                    <div>
                      {post.data.coverImage && (
                        <div class="aspect-16/9 mb-5 overflow-hidden rounded-xl bg-slate-800">
                          <img
                            src={post.data.coverImage}
                            alt={post.data.title}
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-102"
                          />
                        </div>
                      )}

                      <div class="flex flex-wrap items-center gap-2 mb-3">
                        {post.data.tags.map((tag) => (
                          <span class="inline-flex items-center rounded-md bg-amber-400/10 px-2.5 py-0.5 text-xs font-semibold text-amber-300">
                            {tag}
                          </span>
                        ))}
                        {post.data.draft && (
                          <span class="inline-flex items-center rounded-md bg-rose-500/10 px-2.5 py-0.5 text-xs font-semibold text-rose-400">
                            Draft
                          </span>
                        )}
                      </div>

                      <h2 class="text-xl font-bold tracking-tight text-white group-hover:text-amber-300 transition-colors">
                        <a
                          href={`/blog/${post.id}`}
                          class="focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:outline-none rounded-md"
                        >
                          {post.data.title}
                        </a>
                      </h2>

                      <p class="mt-3 text-sm text-slate-300 line-clamp-3 leading-relaxed">
                        {post.data.description}
                      </p>
                    </div>

                    <div class="mt-6 flex items-center justify-between border-t border-slate-800/80 pt-4 text-xs text-slate-400">
                      <div class="flex items-center gap-1.5">
                        <span>By</span>
                        <span class="font-medium text-slate-200">{post.data.author}</span>
                      </div>
                      <time datetime={post.data.publishedAt.toISOString()}>{formattedDate}</time>
                    </div>
                  </article>
                );
              })}
            </div>
          )
        }
      </main>
    </div>

    <Footer />
  </div>
</Layout>
