---
import Layout from '../../layouts/Layout.astro';
import { actions } from 'astro:actions';
import { getDb, leads, bridgeDatabaseEnv, eq } from '@pmg/db';

const result = Astro.getActionResult(actions.submitOnboarding);
const inputErrors = result?.error && 'fields' in result.error ? result.error.fields : {};
const isSuccess = result?.data?.success === true;

// Query parameters for pre-filling and theming
const leadId = Astro.url.searchParams.get('lead') || '';
const divisionParam = (Astro.url.searchParams.get('division') || 'pmg').toLowerCase();

// Safe lead data pre-population
let prefilled = {
	contactName: '',
	companyName: '',
	email: '',
	phone: '',
	division: divisionParam,
};

if (leadId) {
	try {
		const env = import.meta.env as Record<string, string | undefined>;
		bridgeDatabaseEnv(env);
		const db = getDb();
		const leadData = await db.query.leads.findFirst({
			where: eq(leads.id, leadId),
		});

		if (leadData) {
			prefilled = {
				contactName: leadData.name || '',
				companyName: leadData.companyName || '',
				email: leadData.email || '',
				phone: leadData.phone || '',
				division: leadData.divisionId ? 'pmg' : divisionParam,
			};
		}
	} catch (e) {
		console.error('[onboard page] Failed to pre-fetch lead:', e);
	}
}

// Brand theming config
const brands: Record<string, { name: string; tag: string; color: string; accent: string; whatsapp: string }> = {
	pmg: {
		name: 'Playhouse Media Group',
		tag: 'Client Account Setup',
		color: '#f97316',
		accent: 'from-orange-500/20 to-transparent',
		whatsapp: '27740491433',
	},
	tes: {
		name: 'Tender Edge Solutions',
		tag: 'Client Compliance Onboarding',
		color: '#c9a227',
		accent: 'from-amber-500/20 to-transparent',
		whatsapp: '27745017094',
	},
	aws: {
		name: 'Apex Web Solutions',
		tag: 'Digital Client Setup',
		color: '#0ea5e9',
		accent: 'from-sky-500/20 to-transparent',
		whatsapp: '27740491433',
	},
};

const currentBrand = brands[divisionParam] || brands.pmg;
---

<Layout
	title={`Client Account Setup — ${currentBrand.name}`}
	description="Set up your client profile in 10 seconds to begin your services and access your projects and quotes."
	robots="noindex, nofollow"
>
	<main class="min-h-screen bg-[#07090e] text-slate-100 flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
		<div class="absolute -top-40 -left-40 w-96 h-96 rounded-full bg-orange-500/10 blur-[120px] pointer-events-none"></div>
		<div class="absolute -bottom-40 -right-40 w-96 h-96 rounded-full bg-blue-500/10 blur-[120px] pointer-events-none"></div>

		<div class="sm:mx-auto sm:w-full sm:max-w-md relative z-10">
			<div class="text-center mb-8">
				<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-xs font-semibold text-orange-400 tracking-wider uppercase mb-3">
					<span class="size-1.5 rounded-full bg-orange-400 animate-pulse"></span>
					{currentBrand.tag}
				</div>
				<h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
					Welcome to {currentBrand.name}
				</h1>
				<p class="text-xs sm:text-sm text-slate-400 mt-2 max-w-sm mx-auto leading-relaxed">
					Please confirm your business details below so we can establish your account profile.
				</p>
			</div>

			<div class="bg-[#0e121d]/90 backdrop-blur-xl border border-white/10 rounded-2xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
				<div class={`absolute top-0 left-0 right-0 h-1 bg-gradient-to-r ${currentBrand.accent}`}></div>

				{isSuccess ? (
					<div class="text-center py-6 space-y-4">
						<div class="size-14 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex items-center justify-center mx-auto mb-2">
							<svg xmlns="http://www.w3.org/2000/svg" class="size-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
							</svg>
						</div>
						<h2 class="text-xl font-bold text-white">Account Profile Received!</h2>
						<p class="text-xs text-slate-300 leading-relaxed max-w-xs mx-auto">
							Thank you for submitting your details. Our team is setting up your profile and will be in touch shortly.
						</p>

						<div class="pt-4 flex flex-col gap-2.5">
							<a
								href={`https://wa.me/${currentBrand.whatsapp}?text=${encodeURIComponent(`Hi ${currentBrand.name}, I have just submitted our onboarding profile.`)}`}
								target="_blank"
								rel="noopener noreferrer"
								class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-xs font-bold text-white bg-[#25D366] hover:bg-[#20bd5a] transition-all shadow-md active:scale-[0.99]"
							>
								<svg class="size-4 fill-current" viewBox="0 0 24 24">
									<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
								</svg>
								<span>Notify on WhatsApp</span>
							</a>
							<a
								href="/"
								class="text-xs text-slate-400 hover:text-white transition-colors py-2 text-center"
							>
								Return to Homepage
							</a>
						</div>
					</div>
				) : (
					<form method="POST" action={actions.submitOnboarding} class="space-y-4" novalidate id="onboard-form">
						<div style="position: absolute; left: -9999px;" aria-hidden="true">
							<input type="text" name="_company_url" tabindex="-1" autocomplete="off" />
						</div>
						<input type="hidden" name="_loadedAt" id="onboard-loaded-at" value="" />
						<input type="hidden" name="leadId" value={leadId} />
						<input type="hidden" name="division" value={divisionParam} />

						{import.meta.env.TURNSTILE_SITE_KEY && (
							<div class="cf-turnstile" data-sitekey={import.meta.env.TURNSTILE_SITE_KEY} data-action="_turnstile" data-theme="dark"></div>
						)}

						{result?.error && !('fields' in result.error) && (
							<div class="p-3 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-xs flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
								</svg>
								<span>Something went wrong. Please try again or message us directly on WhatsApp.</span>
							</div>
						)}

						<div>
							<label for="contactName" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
								Your Full Name <span class="text-orange-400">*</span>
							</label>
							<input
								type="text"
								id="contactName"
								name="contactName"
								required
								autocomplete="name"
								placeholder="e.g. Jacob Dlamini"
								value={prefilled.contactName}
								class="w-full rounded-xl bg-white/[0.04] border border-white/10 px-3.5 py-2.5 text-xs text-white placeholder-slate-500 outline-none transition-all focus:border-orange-500 focus:bg-white/[0.07] focus:ring-2 focus:ring-orange-500/20"
							/>
							{inputErrors.contactName?.[0] && (
								<p class="text-red-400 text-[11px] mt-1">{inputErrors.contactName[0]}</p>
							)}
						</div>

						<div>
							<label for="companyName" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
								Business / Company Name <span class="text-orange-400">*</span>
							</label>
							<input
								type="text"
								id="companyName"
								name="companyName"
								required
								autocomplete="organization"
								placeholder="e.g. Apex Enterprises Pty Ltd"
								value={prefilled.companyName}
								class="w-full rounded-xl bg-white/[0.04] border border-white/10 px-3.5 py-2.5 text-xs text-white placeholder-slate-500 outline-none transition-all focus:border-orange-500 focus:bg-white/[0.07] focus:ring-2 focus:ring-orange-500/20"
							/>
							{inputErrors.companyName?.[0] && (
								<p class="text-red-400 text-[11px] mt-1">{inputErrors.companyName[0]}</p>
							)}
						</div>

						<div>
							<label for="email" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
								Email Address <span class="text-orange-400">*</span>
							</label>
							<input
								type="email"
								id="email"
								name="email"
								required
								autocomplete="email"
								placeholder="e.g. jacob@example.co.za"
								value={prefilled.email}
								class="w-full rounded-xl bg-white/[0.04] border border-white/10 px-3.5 py-2.5 text-xs text-white placeholder-slate-500 outline-none transition-all focus:border-orange-500 focus:bg-white/[0.07] focus:ring-2 focus:ring-orange-500/20"
							/>
							{inputErrors.email?.[0] && (
								<p class="text-red-400 text-[11px] mt-1">{inputErrors.email[0]}</p>
							)}
						</div>

						<div>
							<label for="phone" class="block text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1.5">
								Phone / WhatsApp Number <span class="text-orange-400">*</span>
							</label>
							<input
								type="tel"
								id="phone"
								name="phone"
								required
								autocomplete="tel"
								placeholder="e.g. 082 123 4567"
								value={prefilled.phone}
								class="w-full rounded-xl bg-white/[0.04] border border-white/10 px-3.5 py-2.5 text-xs text-white placeholder-slate-500 outline-none transition-all focus:border-orange-500 focus:bg-white/[0.07] focus:ring-2 focus:ring-orange-500/20"
							/>
							{inputErrors.phone?.[0] && (
								<p class="text-red-400 text-[11px] mt-1">{inputErrors.phone[0]}</p>
							)}
						</div>

						<div>
							<div class="flex items-center justify-between mb-1.5">
								<label for="registrationNumber" class="block text-[11px] font-bold uppercase tracking-wider text-slate-400">
									CIPC Registration No.
								</label>
								<span class="text-[10px] text-slate-500 uppercase tracking-wider font-semibold">Optional</span>
							</div>
							<input
								type="text"
								id="registrationNumber"
								name="registrationNumber"
								placeholder="e.g. 2024/123456/07"
								class="w-full rounded-xl bg-white/[0.04] border border-white/10 px-3.5 py-2.5 text-xs text-white placeholder-slate-500 outline-none transition-all focus:border-orange-500 focus:bg-white/[0.07] focus:ring-2 focus:ring-orange-500/20 font-mono"
							/>
						</div>

						<div class="pt-2">
							<button
								type="submit"
								id="onboard-submit-btn"
								class="w-full py-3.5 px-4 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 shadow-lg shadow-orange-500/20 transition-all active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer"
							>
								<span>Establish Client Profile</span>
								<svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
								</svg>
							</button>
						</div>
					</form>
				)}
			</div>

			<p class="text-center text-[11px] text-slate-500 mt-6">
				Protected by Playhouse Media Group security protocols.
			</p>
		</div>
	</main>

	<script>
		const loadedAtInput = document.getElementById('onboard-loaded-at') as HTMLInputElement | null;
		if (loadedAtInput) {
			loadedAtInput.value = Date.now().toString();
		}

		const form = document.getElementById('onboard-form') as HTMLFormElement | null;
		const submitBtn = document.getElementById('onboard-submit-btn') as HTMLButtonElement | null;
		if (form && submitBtn) {
			form.addEventListener('submit', () => {
				submitBtn.disabled = true;
				submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
				submitBtn.innerHTML = `
					<svg class="animate-spin size-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
					</svg>
					<span>Submitting Profile...</span>
				`;
			});
		}
	</script>
</Layout>
